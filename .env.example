# Family Document Vault — example. Run `node scripts/gen-env.mjs` to make a real one.
#
# KEEP A COPY OF THIS FILE SOMEWHERE SAFE, OFF THIS MACHINE.
# FDV_MASTER_KEY wraps every other key. Without it, the files are unreadable.

# The one line to change: what your family calls this vault.
FDV_DISPLAY_NAME=Our family vault

# Port the web app is served on.
FDV_PORT=8080

# The family's time zone, an IANA name: every time the vault shows, and the
# hour reminders arrive, are on it. An owner can choose another in Settings
# → Time zone, which overrides this. UTC unless set.
# FDV_TIMEZONE=Europe/London

# --- secrets: generated, do not share -----------------------------------
FDV_MASTER_KEY=replace-with-32-random-bytes-base64url
FDV_DB_PASSWORD=replace-me
FDV_DB_APP_PASSWORD=replace-me

# --- optional --------------------------------------------------------------
# LOG_LEVEL=info
# FDV_VERSION=latest
# The scanner folder (README, "Scanning straight into the vault"): also
# uncomment the worker's ./scanner:/watch mount in docker-compose.yml.
# FDV_WATCH_DIR=/watch
# The folders mounted into the worker an owner may choose the scanner folder
# inside, in Settings (comma-separated; FDV_WATCH_DIR may always be chosen).
# Never / nor a folder above the vault's data volume: the worker refuses it.
# FDV_WATCH_ROOTS=/watch
# How long a scan must stop changing before it is taken (seconds).
# FDV_WATCH_STABLE_SECONDS=10
# How long a scan that looks unfinished waits before it is taken anyway (seconds).
# FDV_WATCH_INCOMPLETE_GRACE_SECONDS=120
# Email in (README, "Emailing documents to the vault"): a dedicated mailbox
# of the household's, checked over IMAP (TLS on 993). The worker's alone.
# An owner can set one up in Settings instead, which overrides these.
# FDV_MAIL_IN_HOST=imap.gmail.com
# FDV_MAIL_IN_USER=smith.vault@gmail.com
# Better as a file the worker reads (a Docker secret) than here:
# FDV_MAIL_IN_PASSWORD_FILE=/run/secrets/mail_in_password
# FDV_MAIL_IN_PASSWORD=an-app-password
# Your provider's Authentication-Results name: only mail it vouched for is taken.
# FDV_MAIL_IN_AUTHSERV_ID=mx.google.com
# FDV_MAIL_IN_FOLDER=INBOX
# FDV_MAIL_IN_POLL_SECONDS=300
# What happens to an email once its attachments are in: move (to "Filed") or delete.
# FDV_MAIL_IN_AFTER=move
# A mailbox an owner sets up in Settings is on port 993, outside your own
# network, unless you allow more (these don't limit FDV_MAIL_IN_* above):
# FDV_MAIL_IN_ALLOWED_PORTS=993
# FDV_MAIL_IN_ALLOW_PRIVATE=false

# The local AI reader (README, "A local AI reader"): a model on this server or
# your own network that reads the papers added many at a time beside the
# vault's rules. Off for each household until an owner turns it on in
# Settings → For owners → Reading. Start the optional `ollama` service with
# `docker compose --profile local-ai up -d` and pull a model first.
# FDV_LOCAL_AI_URL=http://ollama:11434
# FDV_LOCAL_AI_MODEL=qwen2.5:3b-instruct
# How long it may take over one paper before the paper is read without it (5 to 300).
# FDV_LOCAL_AI_TIMEOUT_SECONDS=120

# Where the family downloads the uploader app that sends scans from a computer.
# Settings → Your computers links to it while a computer is paired.
# FDV_DESKTOP_DOWNLOAD_URL=https://example.com/family-documents-vault-uploader
# The most one paired computer may send in a day, in bytes (2 GB unless set).
# FDV_DEVICE_DAILY_BYTES=2147483648
