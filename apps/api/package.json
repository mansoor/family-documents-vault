{
  "name": "@fdv/api",
  "version": "0.0.1",
  "private": true,
  "description": "The Family Document Vault API service.",
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "node ../../scripts/bundle.mjs src/server.ts dist/server.mjs && node ../../scripts/bundle.mjs src/cli.ts dist/cli.mjs",
    "start": "node dist/server.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fastify/rate-limit": "^11.2.0",
    "@fdv/crypto": "workspace:^",
    "@fdv/db": "workspace:^",
    "@fdv/shared": "workspace:*",
    "argon2": "^0.45.1",
    "fastify": "^5.12.5",
    "jose": "^6.2.12",
    "kysely": "^0.29.6",
    "pg": "^8.23.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "pino-pretty": "^13.1.3",
    "tsx": "^4.23.15"
  }
}
