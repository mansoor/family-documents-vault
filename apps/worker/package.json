{
  "name": "@fdv/worker",
  "version": "0.0.1",
  "private": true,
  "description": "Background jobs: OCR, thumbnails, reminders, exports, audit verification.",
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "node ../../scripts/bundle.mjs src/main.ts dist/main.mjs && node ../../scripts/bundle.mjs src/cli.ts dist/cli.mjs && node ../../scripts/check-bundle-deps.mjs .",
    "start": "node dist/main.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1137.0",
    "@fdv/crypto": "workspace:^",
    "@fdv/db": "workspace:*",
    "@fdv/shared": "workspace:*",
    "@fdv/storage": "workspace:^",
    "archiver": "^8.0.0",
    "argon2": "^0.45.1",
    "kysely": "^0.29.6",
    "nodemailer": "^10.0.10",
    "pg": "^8.23.0",
    "pg-boss": "^12.33.4",
    "web-push": "^3.6.7",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/archiver": "^8.0.0",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/web-push": "^3.6.4",
    "http_ece": "1.2.0",
    "tsx": "^4.23.15"
  }
}
