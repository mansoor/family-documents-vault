# HTTPS with a real certificate, for a vault reachable from outside the
# house at a name you own.
#
# Caddy gets and renews the certificate from Let's Encrypt by itself. It
# needs two things from you: FDV_HOSTNAME pointing at this machine in
# public DNS, and ports 80 and 443 reachable from the internet.
#
# Think before you use this one. A vault on the open internet is a vault
# anyone can knock on; the sign-in is strong, but the safer arrangement
# for most families is Caddyfile.internal plus a VPN such as Tailscale,
# which gives you a real certificate without opening anything.

{
	email {$FDV_TLS_EMAIL}
	admin off
	# What nginx bounded on :8080 is bounded here (the 5.30 review, X530-3),
	# as the API's requests now come to it straight from Caddy: a request's
	# headers within 10 seconds; the whole of it, an upload as large as
	# FDV_MAX_UPLOAD_BYTES (100 MB unless raised) on a slow home connection
	# included, within 30 minutes; a connection left idle, 2 minutes. The
	# API cuts off an upload over its limit itself.
	servers {
		timeouts {
			read_header 10s
			read_body 30m
			idle 2m
		}
	}
}

{$FDV_HOSTNAME} {
	encode zstd gzip

	# The API's requests go to the API itself (5.30), with the address Caddy
	# was reached from; nginx would tell it Caddy's (Caddyfile.internal).
	@api path /api/* /healthz /readyz
	handle @api {
		reverse_proxy api:3000 {
			flush_interval -1
		}
	}

	handle {
		reverse_proxy web:80 {
			flush_interval -1
		}
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		# A default: the pages outsiders open send no-referrer (nginx.conf), and keep it.
		?Referrer-Policy same-origin
		-Server
	}
}
